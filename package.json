{
  "name": "ssr-saas-mern",
  "version": "2.0.0",
  "description": "MERN rewrite of the SSR SaaS sales, stock, and reporting application.",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node scripts/run-dev-service.mjs server",
    "client:dev": "node scripts/run-dev-service.mjs client",
    "start": "node server/src/index.js",
    "build": "vite build --configLoader native --config client/vite.config.js",
    "preview": "vite preview --configLoader native --config client/vite.config.js --host 0.0.0.0 --port 4173",
    "check": "node server/scripts/checkSyntax.js",
    "test": "set NODE_ENV=test&& node --test server/src/tests/multiTenancy.test.js",
    "test:integration": "set NODE_ENV=test&& node --test server/src/tests/multiTenancy.test.js",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "express-timeout-header": "^1.1.5",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "mongodb": "^6.10.0",
    "nodemon": "^3.1.9",
    "vite": "^6.0.7"
  }
}
